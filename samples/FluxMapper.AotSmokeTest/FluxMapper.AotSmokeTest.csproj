<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An actual `dotnet publish -p:PublishAot=true` smoke test, not just static trim/AOT analysis. This
    project deliberately references ONLY FluxMapper.Abstractions (for the [MapFrom] attribute) plus
    FluxMapper.SourceGenerator as an analyzer, never FluxMapper.Core, so the only mapping path in play is
    the source-generated, zero-reflection, zero-Expression.Compile() tier that reports
    ExecutionEligibility.AotSafe = true. FluxMapper.Core's expression-tree tier is INTENTIONALLY excluded
    here: it is already correctly marked [RequiresDynamicCode]/[RequiresUnreferencedCode]; this project is
    not the place to re-prove it is unsafe, it is the place to prove the safe tier actually survives a
    real Native AOT publish and runs correctly as a native executable.

    Run it with (from this directory): dotnet publish -c Release -r &lt;rid&gt;, where &lt;rid&gt; is
    your platform's runtime identifier (e.g. win-x64, linux-x64, osx-arm64); PublishAot=true already
    forces a self contained publish, so no separate flag is needed. Then run the produced native
    executable under bin/Release/net10.0/&lt;rid&gt;/publish/; it prints PASS/FAIL and exits 0/1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluxMapper.Abstractions\FluxMapper.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FluxMapper.SourceGenerator\FluxMapper.SourceGenerator.csproj"
                       OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated/**/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

</Project>
