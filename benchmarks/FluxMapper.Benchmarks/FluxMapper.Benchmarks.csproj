<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This is a hand-rolled Stopwatch-based benchmark harness rather than a BenchmarkDotNet project: real
    wall-clock measurements of real compiled code (warm JIT, many iterations averaged), not a placeholder.
    Swap this for a real BenchmarkDotNet project (the scenarios below translate directly to
    [Benchmark]-attributed methods on a class) as a future packaging follow-up if wanted.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FluxMapper.Core\FluxMapper.Core.csproj" />
    <ProjectReference Include="..\..\src\FluxMapper.Abstractions\FluxMapper.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FluxMapper.SourceGenerator\FluxMapper.SourceGenerator.csproj"
                       OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    AutoMapper is pinned to 14.0.0 deliberately: the last version released under AutoMapper's original
    MIT license before the commercial-licensing change in 15.0.0. Benchmarking against it here is not
    "production use" of AutoMapper by any reasonable reading, but pinning to the last unambiguously free
    version avoids any question about it, and it is also the version realistically still running in most
    free-tier codebases that have not paid to upgrade.
  -->
  <!--
    NU1903: AutoMapper has a known high-severity DoS advisory (GHSA-rvv3-g6hj-g44x / CVE-2026-32933,
    uncontrolled recursion -> StackOverflowException) affecting every version before 15.1.1, which
    includes 14.0.0, the version pinned above. There is no version of AutoMapper that is both unaffected
    and still under the original MIT license: the fix landed in 15.1.1, after the commercial-licensing
    change in 15.0.0. Suppressed here, narrowly, for this one project only: this benchmark never ships,
    never runs against untrusted input, and maps simple flat/nested POCOs with no self-referential or
    deeply nested structure for the exploit to recurse through.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Mapster" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated/**/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
